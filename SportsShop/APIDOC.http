# Get all
###
GET http://127.0.0.1:8000/categories/
Accept: application/json

#Create
###
POST http://127.0.0.1:8000/categories/
Content-Type: application/json

{
    "category_name":"Cricket Equipment",
    "description":"Cricket bats, balls, pads and gloves"
}

# Get one
###
GET http://127.0.0.1:8000/category/1/
Accept: application/json

# Update
###
PUT http://127.0.0.1:8000/category/1/
Content-Type: application/json

{
    "category_name":"Cricket Accessories",
    "description":"Cricket equipment and accessories"
}

# Delete
###
DELETE http://127.0.0.1:8000/category/1/
Accept: application/json